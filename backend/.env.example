# Database
DATABASE_URL=postgresql://user:password@host:5432/zenith

# JWT — WAJIB diisi, gunakan string acak panjang (min 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (untuk Gmail & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ElevenLabs TTS (opsional)
ELEVENLABS_API_KEY=

# CORS — domain frontend yang diizinkan, pisahkan dengan koma
# Contoh: https://zenith.ai,https://app.zenith.ai
# Kosongkan untuk allow all (TIDAK AMAN di production)
CORS_ORIGINS=https://yourdomain.com
